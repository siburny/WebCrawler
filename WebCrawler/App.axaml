<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WebCrawler.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <!-- Selected rows use the Base blue rather than the (orange/red) accent, so row text stays readable. -->
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#A9D3EE" />
          <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="#9ACBEA" />
          <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="#B9DDF3" />
          <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="#AED6F0" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#0B4948" />
          <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="#0B5351" />
          <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="#0A3D3D" />
          <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="#0B4948" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <!-- Region = window background, Base = chrome (headers, borders, buttons), Primary = accent. -->
        <ColorPaletteResources x:Key="Light" Accent="#CC4D11"
                               RegionColor="#CFEAFF"
                               AltHigh="#EAF5FF"
                               AltMedium="#EAF5FF"
                               AltMediumHigh="#EAF5FF"
                               AltMediumLow="#EAF5FF"
                               AltLow="#EAF5FF"
                               ChromeLow="#BFE0F5"
                               ChromeMediumLow="#AFD7F0"
                               ChromeMedium="#9ACBEA"
                               ChromeHigh="#7CBEE0"
                               ListLow="#BCDDF3"
                               ListMedium="#A9D3EE" />
        <ColorPaletteResources x:Key="Dark" Accent="#00A9A5"
                               RegionColor="#092327"
                               AltHigh="#061A1D"
                               AltMedium="#061A1D"
                               AltMediumHigh="#061A1D"
                               AltMediumLow="#061A1D"
                               AltLow="#061A1D"
                               ChromeLow="#0B2F31"
                               ChromeMediumLow="#0B3D3C"
                               ChromeMedium="#0B4948"
                               ChromeHigh="#0B5351"
                               ListLow="#0C3033"
                               ListMedium="#0B4140" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
  </Application.Styles>
</Application>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WebCrawler.ViewModels"
        x:Class="WebCrawler.Views.InfoWindow"
        x:DataType="vm:InfoViewModel"
        Title="Link Information"
        Width="1000" Height="480" MinWidth="400" MinHeight="300"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,*,Auto" Margin="12">
    <TextBlock Grid.Row="0" Text="Link" />
    <TextBox Grid.Row="1" Text="{Binding Link, Mode=OneWay}" IsReadOnly="True" Margin="0,4,0,10" />
    <TextBlock Grid.Row="2" Text="Linked From" />
    <TextBox Grid.Row="3" Text="{Binding LinkedFrom, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Margin="0,4,0,10"
             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
    <TextBlock Grid.Row="4" Text="Links To" />
    <TextBox Grid.Row="5" Text="{Binding LinksTo, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Margin="0,4,0,10"
             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
    <Button Grid.Row="6" Name="CloseButton" Content="Close" HorizontalAlignment="Right" MinWidth="100"
            HorizontalContentAlignment="Center" IsCancel="True" IsDefault="True" />
  </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WebCrawler.ViewModels"
        x:Class="WebCrawler.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Web Crawler"
        Width="1200" Height="620" MinWidth="700" MinHeight="300"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+F" Command="{Binding OpenFindCommand}" />
    <KeyBinding Gesture="Meta+F" Command="{Binding OpenFindCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="Button.tool">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding StatusText}" />
    </Border>

    <!-- Tool bar -->
    <DockPanel DockPanel.Dock="Top" Margin="4,4,4,0">
      <Button DockPanel.Dock="Right" Classes="tool" Content="Settings" Command="{Binding OpenSettingsCommand}" />
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="tool" Content="Load URL List" Command="{Binding LoadUrlListCommand}" />
        <Border Width="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="4,4" />
        <Button Classes="tool" Command="{Binding StartStopCommand}" ToolTip.Tip="Start or stop the scan" AutomationProperties.Name="Play or stop">
          <Panel Width="16" Height="16">
            <Path Data="M 3,2 L 14,8 L 3,14 Z" Fill="SeaGreen" IsVisible="{Binding !IsCrawling}" />
            <Path Data="M 3,3 L 13,3 L 13,13 L 3,13 Z" Fill="Firebrick" IsVisible="{Binding IsCrawling}" />
          </Panel>
        </Button>
        <Border Width="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="4,4" />
        <Button Classes="tool" Content="Show Next Error" Command="{Binding ShowNextErrorCommand}" />
        <Button Classes="tool" Content="Show Next Highlight" Command="{Binding ShowNextHighlightCommand}" />
        <Button Classes="tool" Content="Find" Command="{Binding OpenFindCommand}" ToolTip.Tip="Find (Ctrl+F)" />
      </StackPanel>
    </DockPanel>

    <!-- URL box -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="8,6">
      <TextBlock Grid.Column="0" Text="URL:" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox Grid.Column="1" Name="UrlBox" Text="{Binding UrlText}">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding StartNewScanCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <Button Grid.Column="2" Classes="accent" Margin="8,0,0,0" MinWidth="115" HorizontalContentAlignment="Center"
              Content="{Binding StartStopText}" Command="{Binding StartStopCommand}" />
    </Grid>

    <!-- Results -->
    <DataGrid Name="Grid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
              IsReadOnly="True" CanUserReorderColumns="False" CanUserSortColumns="False"
              SelectionMode="Single" GridLinesVisibility="Horizontal" RowHeight="22"
              HorizontalScrollBarVisibility="Auto" Margin="0,2,0,0">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Status" Width="90" CanUserResize="False">
          <DataTemplate x:DataType="vm:UrlRow">
            <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Ellipse Width="16" Height="16" Fill="{Binding IconFill}" />
              <Path Data="{Binding IconMark}" Stroke="White" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" />
            </Canvas>
          </DataTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Url" Width="3*" MinWidth="250">
          <DataTemplate x:DataType="vm:UrlRow">
            <TextBlock Text="{Binding Address}" Foreground="{Binding Foreground}" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Status" Width="110">
          <DataTemplate x:DataType="vm:UrlRow">
            <TextBlock Text="{Binding Status}" Foreground="{Binding Foreground}" VerticalAlignment="Center" Margin="6,0" />
          </DataTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="HTTP" Width="95">
          <DataTemplate x:DataType="vm:UrlRow">
            <TextBlock Text="{Binding HttpCode}" Foreground="{Binding Foreground}" VerticalAlignment="Center" Margin="6,0" />
          </DataTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Depth" Width="95">
          <DataTemplate x:DataType="vm:UrlRow">
            <TextBlock Text="{Binding Depth}" Foreground="{Binding Foreground}" VerticalAlignment="Center" Margin="6,0" />
          </DataTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Mime Type" Width="150">
          <DataTemplate x:DataType="vm:UrlRow">
            <TextBlock Text="{Binding MimeType}" Foreground="{Binding Foreground}" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Content Length" Width="165">
          <DataTemplate x:DataType="vm:UrlRow">
            <TextBlock Text="{Binding ContentLength}" Foreground="{Binding Foreground}" VerticalAlignment="Center" Margin="6,0" />
          </DataTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Time Taken" Width="130">
          <DataTemplate x:DataType="vm:UrlRow">
            <TextBlock Text="{Binding TimeTaken}" Foreground="{Binding Foreground}" VerticalAlignment="Center" Margin="6,0" />
          </DataTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Notes" Width="*" MinWidth="80">
          <DataTemplate x:DataType="vm:UrlRow">
            <TextBlock Text="{Binding Notes}" Foreground="{Binding Foreground}" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis" MaxLines="1" ToolTip.Tip="{Binding Notes}" />
          </DataTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>

root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C# files: UTF-8 with BOM and Windows line endings, as Visual Studio writes them.
[*.cs]
charset = utf-8-bom
end_of_line = crlf
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true

# Generated by the Windows Forms designer.
[*.Designer.cs]
generated_code = true

[*.{csproj,props,targets,resx}]
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2
end_of_line = lf

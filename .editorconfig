root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C# files: UTF-8 and Unix (LF) line endings, so files are the same on macOS, Linux and Windows.
[*.cs]
charset = utf-8
end_of_line = lf
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true

[*.{csproj,props,targets,resx}]
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2
end_of_line = lf
